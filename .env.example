# Clerk (web)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# Standalone Fastify API base URL. When set, the web client sends all /api
# requests there with a Clerk Bearer token instead of using the in-process
# Next.js routes. Leave unset to fall back to the legacy same-origin routes.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Legacy in-process Next.js API routes (only needed while NEXT_PUBLIC_API_URL is unset)
MONGODB_URI=mongodb://localhost:27017/xtreme-livestream
LIVEKIT_URL=wss://replace-me.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

# WorldSpace messaging (the social gateway). Threads opened from a stream
# page live there and show in WorldSpace and the app too. Optional: defaults
# to production.
NEXT_PUBLIC_SOCIAL_API_URL=https://social-api.worldstreetgold.com
