NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info
TRUST_PROXY=false

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=xtreme-livestream

CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me
# Comma-separated web origins that may mint/use Clerk session tokens.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000,https://worldstreetgold.com,https://www.worldstreetgold.com

# Browser origins only. Native mobile requests normally do not send Origin.
CORS_ORIGINS=http://localhost:3000,https://worldstreetgold.com,https://www.worldstreetgold.com

LIVEKIT_URL=wss://replace-me.livekit.cloud
LIVEKIT_API_KEY=replace_me
LIVEKIT_API_SECRET=replace_me

RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
